{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "isolatedModules": true
  },
  "include": [
    "app", "components", "lib", "main.tsx", "vite.config.ts", "tailwind.config.ts"
  ],
  "exclude": [
    "node_modules", "dist"
  ]
}
