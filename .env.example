NODE_ENV=development
WEB_URL=http://localhost:3000
WEB_URLS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
AI_URL=http://localhost:8000
# Production general-object, label, and brand recognition. Keep keys server-side only.
# Groq is tried first for photos; its Qwen vision model has a free developer tier.
# GROQ_API_KEY=your_server_side_groq_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Gemini remains available for photo fallback and powers text/goal planning.
# GEMINI_API_KEY=your_server_side_google_ai_studio_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_TIMEOUT_MS=45000
# Or add an OpenAI-compatible vision provider as the final cloud fallback.
# OPENAI_API_KEY=your_server_side_key
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-5.6-luna
VISION_TIMEOUT_MS=120000
DATABASE_URL=postgresql://completeit:completeit@localhost:5432/completeit?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_FORCE_PATH_STYLE=true
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=completeit
MINIO_SECRET_KEY=completeit-local-secret
MINIO_BUCKET=completeit
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
EMAIL_TOKEN_SECRET=local-email-token-secret-change-me
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=CompleteIt <no-reply@completeit.local>
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_PREVIEW_URL=http://localhost:8025
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
