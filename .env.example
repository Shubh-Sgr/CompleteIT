NODE_ENV=development
WEB_URL=http://localhost:3000
WEB_URLS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
AI_URL=http://localhost:8000
# Production general-object and label recognition. Keep this server-side only.
# GEMINI_API_KEY=your_server_side_google_ai_studio_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-lite
# Or use an OpenAI-compatible vision provider instead.
# OPENAI_API_KEY=your_server_side_key
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-5.6-luna
VISION_TIMEOUT_MS=45000
DATABASE_URL=postgresql://completeit:completeit@localhost:5432/completeit?schema=public
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_FORCE_PATH_STYLE=true
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=completeit
MINIO_SECRET_KEY=completeit-local-secret
MINIO_BUCKET=completeit
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
EMAIL_TOKEN_SECRET=local-email-token-secret-change-me
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=CompleteIt <no-reply@completeit.local>
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_PREVIEW_URL=http://localhost:8025
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
